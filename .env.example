# ── 大模型 API（必填）────────────────────────────────────────
# 从 https://bailian.console.aliyun.com/ 获取 DashScope API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 鉴权（生产必填）──────────────────────────────────────────
# 至少 32 字节。生成方式（Git Bash / Linux）：
#   openssl rand -hex 32
# 换掉它 = 之前签发的所有 token 立刻失效，用户需要重新登录
ZST_JWT_SECRET=change_me_to_a_random_32_byte_string

# 邀请码（公网部署强烈建议开启）
# 不填 = 任何人都能注册。填了 = 注册接口必须带 invite_code，否则 403。
# 为什么需要它：注册一次就能用掉你的 DashScope 额度，公网裸奔等于把钱包挂在门口。
# 启动日志里会打 "invite_code": "on"/"off"，部署完看一眼就知道有没有生效。
# ZST_INVITE_CODE=zst-2026-please-change

# ── Redis（可选）────────────────────────────────────────────
# URL 优先；不填则走下面的 HOST/PORT；都没有 = 缓存关闭（功能不受影响，只是不缓存）
# 本地起一个：docker run -d -p 6379:6379 redis:7-alpine
ZST_REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── 数据库（可选）───────────────────────────────────────────
# 不填默认 data/app.db。容器里会被 compose 覆盖成 sqlite:////app/data/app.db
# ZST_DB_URL=sqlite:///data/app.db

# ── 日志（可选）─────────────────────────────────────────────
# text = 人眼友好（默认）；json = 一行一个 JSON，给 ELK/Loki 收
# ZST_LOG_FORMAT=text
# ZST_LOG_LEVEL=INFO
# 0 = 不写文件，只打 stdout（容器里推荐）
# ZST_LOG_TO_FILE=0
